# Next.js + Payload runtime (Node 24 + PostgreSQL). Not used by the GitHub Pages static preview.
# Copy to .env and fill in. Never commit .env or real credentials.

# At least 32 random characters:  openssl rand -base64 48
PAYLOAD_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://mis_user:replace@localhost:5432/mis_portfolio
# Disposable database wiped by `pnpm test:int` / `pnpm test:e2e`; name must contain "test".
TEST_DATABASE_URL=postgresql://mis_user:replace@localhost:5432/mis_portfolio_test
# Public origin of the site. Also the only origin allowed for CORS/CSRF against the API.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enables the admin "Preview" button for drafts. Leave empty to disable previews.
PREVIEW_SECRET=

# Upload storage (outside public/ on purpose). Defaults: uploads/public-media and uploads/private-media.
# PUBLIC_MEDIA_DIR=
# PRIVATE_MEDIA_DIR=

# Demo mode: serve content/demo-content.json instead of the database (static-like demo only).
# USE_DEMO_CONTENT=true

# First admin bootstrap (used once by `pnpm seed:admin`; refuses to run if any user exists).
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=

# Configure before enabling forgot-password or public contact submission (not wired yet).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
